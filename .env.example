# Copy to .env and fill in. Never commit .env.

# --- Required --------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Models (format "provider:model", see langchain init_chat_model) -------
# Stronger model: planning, replanning, final answer
PLANNER_MODEL=openai:gpt-5.6-terra
# Cheaper/faster model: per-task tool-using executors
EXECUTOR_MODEL=openai:gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Optional: LangSmith tracing (https://smith.langchain.com) --------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=general-agent

# --- Optional: behaviour / limits ------------------------------------------
# USER_ID=default-user
# MAX_TASKS_PER_PLAN=8
# MAX_REPLANS=2
# EXECUTOR_MAX_STEPS=8
# REQUIRE_WRITE_APPROVAL=true
# LOG_LEVEL=WARNING
