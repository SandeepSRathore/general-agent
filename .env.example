# Copy to .env and fill in. Never commit .env.

# --- Required --------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Models (format "provider:model", see langchain init_chat_model) -------
# Defaults use the cheapest model everywhere (quality traded for cost).
# gpt-5-nano shuts down 2026-12-11 -> then use openai:gpt-5.6-luna (cheapest non-deprecated).
# For better quality: PLANNER_MODEL=openai:gpt-5.6-terra, EXECUTOR_MODEL=openai:gpt-5.4-mini
# Planning, replanning, final answer
PLANNER_MODEL=openai:gpt-5-nano
# Per-task tool-using executors
EXECUTOR_MODEL=openai:gpt-5-nano
# minimal | low | medium | high (reasoning tokens are billed as output); empty to omit
REASONING_EFFORT=minimal
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Optional: LangSmith tracing (https://smith.langchain.com) --------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=general-agent

# --- Optional: HTTP API (uv run agent serve) --------------------------------
# Required to bind to anything other than 127.0.0.1; clients send "Authorization: Bearer <token>"
# API_TOKEN=change-me
# API_MAX_MESSAGE_CHARS=8000

# --- Optional: behaviour / limits ------------------------------------------
# USER_ID=default-user
# MAX_TASKS_PER_PLAN=8
# MAX_REPLANS=2
# EXECUTOR_MAX_STEPS=8
# REQUIRE_WRITE_APPROVAL=true
# LOG_LEVEL=WARNING
